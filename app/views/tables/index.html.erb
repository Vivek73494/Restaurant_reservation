<div class="d-flex justify-content-between align-items-center mb-4">
  <h2>Available Tables</h2>
  <%= link_to "Book a Table", new_reservation_path, class: "btn btn-dark" %>
</div>

<div class="row g-4">
  <% @tables.each do |table| %>
    <div class="col-md-4 col-sm-6">
      <div class="card h-100 shadow-sm">
        <div class="card-body text-center">
          <i class="bi bi-grid-3x3-gap fs-1 text-dark"></i>
          <h4 class="card-title mt-2">Table #<%= table.table_number %></h4>
          <p class="card-text text-muted">
            <i class="bi bi-people"></i> Capacity: <strong><%= table.capacity %></strong> guests
          </p>
          <%= link_to "Book This Table", new_reservation_path(table_id: table.id), class: "btn btn-outline-dark btn-sm" %>
        </div>
      </div>
    </div>
  <% end %>
</div>
