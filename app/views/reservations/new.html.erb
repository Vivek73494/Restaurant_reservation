<div class="row justify-content-center">
  <div class="col-md-6">
    <div class="card shadow">
      <div class="card-body p-4">
        <h4 class="card-title mb-4"><i class="bi bi-calendar-plus"></i> Book a Table</h4>

        <% if @reservation.errors.any? %>
          <div class="alert alert-danger">
            <ul class="mb-0">
              <% @reservation.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <%= form_with model: @reservation, local: true do |f| %>
          <div class="mb-3">
            <%= f.label :table_id, "Select Table", class: "form-label" %>
            <%= f.select :table_id,
                  @tables.map { |t| ["Table ##{t.table_number} (Capacity: #{t.capacity})", t.id] },
                  { prompt: "Choose a table" },
                  class: "form-select" %>
          </div>
          <div class="mb-3">
            <%= f.label :date, class: "form-label" %>
            <%= f.date_field :date, class: "form-control", min: Date.today %>
          </div>
          <div class="mb-3">
            <%= f.label :time_slot, "Time Slot", class: "form-label" %>
            <%= f.select :time_slot,
                  Reservation::TIME_SLOTS.map { |s| ["#{s.gsub('-', ':00 - ')}:00", s] },
                  { prompt: "Choose a time slot" },
                  class: "form-select" %>
          </div>
          <div class="d-flex gap-2">
            <%= f.submit "Confirm Booking", class: "btn btn-dark" %>
            <%= link_to "Cancel", reservations_path, class: "btn btn-outline-secondary" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
