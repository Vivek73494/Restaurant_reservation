<div class="row justify-content-center mt-5">
  <div class="col-md-4">
    <div class="card shadow">
      <div class="card-body p-4">
        <h3 class="card-title text-center mb-4">
          <i class="bi bi-fork-knife text-dark"></i> ReserveTable
        </h3>
        <h5 class="text-center text-muted mb-4">Sign in to your account</h5>

        <%= form_with url: login_path, local: true do |f| %>
          <div class="mb-3">
            <%= f.label :username, class: "form-label" %>
            <%= f.text_field :username, class: "form-control", placeholder: "Enter username", autofocus: true %>
          </div>
          <div class="mb-3">
            <%= f.label :password, class: "form-label" %>
            <%= f.password_field :password, class: "form-control", placeholder: "Enter password" %>
          </div>
          <%= f.submit "Login", class: "btn btn-dark w-100" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
