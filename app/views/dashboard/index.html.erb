<div class="row mb-4">
  <div class="col">
    <h2>Welcome back, <strong><%= current_user.username %></strong>! 👋</h2>
    <p class="text-muted">Manage your restaurant table reservations below.</p>
  </div>
</div>

<div class="row g-4 mb-4">
  <div class="col-md-4">
    <div class="card text-white bg-dark h-100">
      <div class="card-body text-center">
        <i class="bi bi-calendar-check fs-1"></i>
        <h3 class="mt-2"><%= @reservations_count %></h3>
        <p class="mb-0">Total Reservations</p>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card text-white bg-secondary h-100">
      <div class="card-body text-center">
        <i class="bi bi-table fs-1"></i>
        <h3 class="mt-2"><%= Table.count %></h3>
        <p class="mb-0">Available Tables</p>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card text-white bg-success h-100">
      <div class="card-body text-center d-flex flex-column align-items-center justify-content-center">
        <i class="bi bi-plus-circle fs-1"></i>
        <p class="mt-2 mb-0">
          <%= link_to "Book a Table", new_reservation_path, class: "btn btn-light mt-2" %>
        </p>
      </div>
    </div>
  </div>
</div>

<% if @upcoming_reservations.any? %>
  <h5>Upcoming Reservations</h5>
  <div class="table-responsive">
    <table class="table table-bordered table-hover">
      <thead class="table-dark">
        <tr>
          <th>Table #</th>
          <th>Date</th>
          <th>Time Slot</th>
        </tr>
      </thead>
      <tbody>
        <% @upcoming_reservations.each do |r| %>
          <tr>
            <td>Table <%= r.table.table_number %></td>
            <td><%= r.date.strftime("%B %d, %Y") %></td>
            <td><%= r.time_slot %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <%= link_to "View All Reservations →", reservations_path, class: "btn btn-outline-dark btn-sm" %>
<% else %>
  <div class="alert alert-info">
    No upcoming reservations. <%= link_to "Book a table now!", new_reservation_path %>
  </div>
<% end %>
